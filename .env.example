# ICSSST 2027 site settings. Copy to .env (never commit .env) or set these in the host's environment variables.
NODE_ENV=production
TRUST_PROXY=1
SITE_URL=https://icssst2027.example.org
# bcrypt hash of the admin password: npm run hash -- "your-password"   (single quotes keep the $ signs)
ADMIN_HASH='$2b$12$replace-me'
# Persistent folder for the database (outside the app folder, so redeploys keep registrations)
# DATA_DIR=/home/USER/icssst2027-data

# Outgoing email (Zoho)
SMTP_HOST=smtppro.zoho.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=events@usmphysics.org
SMTP_PASS=

# Google sign-in (optional; leave empty to hide the button). Redirect URI: SITE_URL/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
